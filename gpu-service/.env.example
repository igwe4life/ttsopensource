# Copy to .env (or pass as container env vars — see Dockerfile / docker-compose.yml).

# --- Device / runtime --------------------------------------------------------
DEVICE=cuda
COMPUTE_TYPE=float16
GPU_ID=0
GPU_PROVIDER=generic
# generic | runpod | hyperstack — informational only, surfaced in /health.
# Nothing in the app branches on this; see deploy/runpod and deploy/hyperstack
# for the provider-specific env var mappings.

# --- Language registry (shared with orchestrator) ---------------------------
LANGUAGE_REGISTRY_PATH=
LANGUAGE_OVERRIDES_PATH=

# --- STT ---------------------------------------------------------------------
STT_ENGINE=faster-whisper
WHISPER_MODEL_SIZE=large-v3
WHISPER_MODEL_DIR=

# --- Translation ---------------------------------------------------------------
NLLB_MODEL_ID=facebook/nllb-200-distilled-600M
NLLB_MAX_BATCH=16
OPUS_MT_MODEL_TEMPLATE=Helsinki-NLP/opus-mt-{src}-{tgt}

# --- TTS -----------------------------------------------------------------------
PIPER_VOICES_DIR=
# Requires onnxruntime-gpu to actually take effect — separate follow-up from
# the persistent-model-loading fix itself.
PIPER_USE_CUDA=false
XTTS_MODEL_ID=coqui/XTTS-v2
MMS_TTS_MODEL_TEMPLATE=facebook/mms-tts-{code}

# --- Model pool / routing (section 7) -------------------------------------
MAX_LOADED_TTS_MODELS=6
MAX_LOADED_TRANSLATION_MODELS=4
MODEL_IDLE_UNLOAD_SECONDS=900

# --- Real-time processing knobs (section 4) --------------------------------
CHUNK_SECONDS=6.0
MAX_QUEUE_DEPTH=8
SEGMENT_DEADLINE_MS=12000

# --- Server --------------------------------------------------------------------
HOST=0.0.0.0
PORT=8000
GPU_SERVICE_API_KEY=
