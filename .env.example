# Copy to .env (same directory as docker-compose.yml — compose reads it
# automatically). This is the ONLY file most people need to touch.
#
#   cp .env.example .env
#   # edit STREAM_URL below
#   docker compose up --build
#
# For a GPU box, additionally:
#   docker compose -f docker-compose.yml -f docker-compose.gpu.yml up --build

# --- Required ----------------------------------------------------------------
# Your live HLS source, e.g. https://example.com/live/stream.m3u8
STREAM_URL=https://example.com/live/stream.m3u8

# --- Optional ------------------------------------------------------------
# Leave DEVICE unset when using docker-compose.yml alone (defaults to cpu —
# works anywhere, slow). The GPU overlay (docker-compose.gpu.yml) sets this
# to cuda for you, so you normally don't need to touch it.
DEVICE=

# Protects the GPU service's API if you expose it beyond localhost. Strongly
# recommended for anything but local trying-it-out.
GPU_SERVICE_API_KEY=

# Host ports (change if 4000/8000 are already taken on your machine).
ORCHESTRATOR_PORT=4000
GPU_SERVICE_PORT=8000
