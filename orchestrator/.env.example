# Copy to .env and fill in. Loaded via `dotenv/config` (see src/config.js).

# --- GPU inference service (section 3 — provider-independent) --------------
GPU_SERVICE_URL=http://localhost:8000
GPU_SERVICE_WS_URL=ws://localhost:8000/ws/stream
GPU_SERVICE_API_KEY=
# Comma-separated extra GPU worker URLs for simple round-robin (optional):
GPU_SERVICE_POOL=
GPU_SERVICE_TIMEOUT_MS=20000

# --- Live orchestration knobs (section 4) -----------------------------------
HLS_SEGMENT_SECONDS=6
POLL_INTERVAL_DIVISOR=2
SEGMENT_DEADLINE_MS=12000
PIPELINE_CONCURRENCY=2
MAX_QUEUE_DEPTH=8
DUCK_LEVEL=0.10

# --- HLS output --------------------------------------------------------------
HLS_WINDOW_SEGMENTS=6
HLS_OUTPUT_DIR=work/hls_out

# --- Shared-pipeline lifecycle (section 5) ----------------------------------
PIPELINE_IDLE_GRACE_MS=30000

# --- HTTP API ----------------------------------------------------------------
HTTP_PORT=4000

# --- RTMP output (optional — see rtmp-targets.json.example / --rtmp-targets) -
# Default RTMP server base used when an rtmp-targets.json entry omits rtmp_server.
RTMP_SERVER=

# --- Language registry (shared with gpu-service; leave unset to use the
# default ../language-registry/languages.json) ------------------------------
LANGUAGE_REGISTRY_PATH=
LANGUAGE_OVERRIDES_PATH=

KEEP_WORK=false
FFMPEG_PATH=
