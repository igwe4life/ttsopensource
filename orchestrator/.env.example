# Copy to .env and fill in. Loaded via `dotenv/config` (see src/config.js).

# --- GPU inference service — continuous streaming over WebSocket -----------
GPU_SERVICE_URL=http://localhost:8000
GPU_SERVICE_WS_URL=ws://localhost:8000/ws/stream
GPU_SERVICE_API_KEY=
# Comma-separated extra GPU worker URLs, for future multi-pod round robin
# (not used yet — see gpuStreamClient.js):
GPU_SERVICE_POOL=

# --- Continuous audio chunking -----------------------------------------------
CHUNK_SECONDS=4
CHUNK_OVERLAP_MS=750
# Ceiling for one chunk's full fan-out (transcribe once + translate/TTS for
# every active language, on one shared GPU connection).
CHUNK_TIMEOUT_MS=15000

# The fixed set of languages generated + broadcast for this build (registry codes).
TARGET_LANGUAGES=es,fr,de

# --- RTMP broadcast — one persistent push per language, always-on ----------
RTMP_SERVER=rtmp://your-rtmp-server.example.com/live
# Prefix stream keys during testing (e.g. "test-") so verification doesn't
# land on the real per-language keys. Empty for production. Only applies to
# a language with no explicit key in RTMP_STREAM_KEYS below.
RTMP_KEY_PREFIX=test-
# Explicit real per-language stream keys (don't have to follow any
# code-derived pattern), e.g.:
# RTMP_STREAM_KEYS=es:SPANISH_30_HS,fr:FRENCH_109_HS,de:GERMAN_21_HS
RTMP_STREAM_KEYS=

# Fixed internal sample rate for the live-mixed translated-audio pipe.
MIX_SAMPLE_RATE=24000
# Cap on how much translated audio can queue up before the oldest excess is
# dropped to catch back up toward real time (bounds delay growth).
MIX_MAX_QUEUED_SECONDS=8
# How loud the original audio stays under the dub (0-1).
DUCK_LEVEL=0.2

# --- HTTP server (monitoring endpoints only — no browser UI) ----------------
HTTP_PORT=4000

# --- Language registry (shared with gpu-service; leave unset to use the
# default ../language-registry/languages.json) ------------------------------
LANGUAGE_REGISTRY_PATH=
LANGUAGE_OVERRIDES_PATH=

# Only needed if ffmpeg isn't on PATH.
FFMPEG_PATH=
