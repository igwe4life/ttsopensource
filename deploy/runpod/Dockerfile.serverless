# RunPod Serverless variant of gpu-service. Build context MUST be the repo
# root (same as gpu-service/Dockerfile):
#   docker build -f deploy/runpod/Dockerfile.serverless -t <tag> .
FROM nvidia/cuda:12.1.1-cudnn8-runtime-ubuntu22.04

ENV DEBIAN_FRONTEND=noninteractive PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1

# Python via deadsnakes, not Ubuntu 22.04's default repo — see
# gpu-service/Dockerfile's identical step for why: the default repo can
# resolve to a Python 3.11 patch predating 3.11.4, which is missing
# `sys.get_int_max_str_digits`, causing a confusing crash loop the first
# time something imports transformers. Confirmed via a real deployment run.
RUN apt-get update && apt-get install -y --no-install-recommends \
        software-properties-common ffmpeg curl ca-certificates \
    && add-apt-repository -y ppa:deadsnakes/ppa \
    && apt-get update && apt-get install -y --no-install-recommends \
        python3.11 python3.11-venv python3.11-distutils \
    && curl -sS https://bootstrap.pypa.io/get-pip.py | python3.11 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /srv/gpu-service
COPY gpu-service/requirements.txt .
RUN python3.11 -m pip install --upgrade pip \
    && python3.11 -m pip install -r requirements.txt \
    && python3.11 -m pip install runpod>=1.6

COPY gpu-service/app ./app
COPY deploy/runpod/handler.py ./handler.py
COPY language-registry /srv/language-registry

ENV LANGUAGE_REGISTRY_PATH=/srv/language-registry/languages.json \
    LANGUAGE_OVERRIDES_PATH=/srv/language-registry/overrides.json \
    PIPER_VOICES_DIR=/srv/models/piper \
    DEVICE=cuda \
    GPU_PROVIDER=runpod

CMD ["python3.11", "handler.py"]
