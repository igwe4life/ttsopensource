# Copy to .env in this same folder (deploy/runpod/.env) and fill in.
# This is deployment tooling config only — nothing here is read by the
# running gpu-service container itself (that's gpu-service/.env.example).

# Your RunPod account API key (runpod.io -> Settings -> API Keys).
# Keep this out of git — deploy/runpod/.env is already gitignored.
RUNPOD_API_KEY=

# Secures gpu-service's own HTTP API once deployed (matches
# GPU_SERVICE_API_KEY in gpu-service/.env.example / orchestrator/.env.example
# — the orchestrator needs the SAME value to authenticate its requests).
GPU_SERVICE_API_KEY=

# Where the built image lives (see .github/workflows/publish-gpu-service.yml).
GHCR_IMAGE=ghcr.io/igwe4life/ttsopensource-gpu:latest

# Pod sizing (see the RTX A5000 / Secure Cloud pricing discussion).
RUNPOD_GPU_TYPE=NVIDIA RTX A5000
RUNPOD_CLOUD_TYPE=SECURE
# torch pulls in the full CUDA toolkit as pip deps + Whisper/NLLB download at
# runtime — give the container real headroom (this is exactly what ran out
# of space in CI before the fix; don't undersize this on the Pod either).
RUNPOD_CONTAINER_DISK_GB=40
